# Admin
RC_ADMIN_KEY=change-me

# Database
DATABASE_URL=sqlite:///./data/rising_compass.db

# CORS (JSON array)
CORS_ORIGINS=["https://risingcompass.net","https://api.risingcompass.net"]

# Anthropic API (required for agent classification)
ANTHROPIC_API_KEY=sk-ant-...

# Genius API (lyrics fetching)
GENIUS_ACCESS_TOKEN=...

# Email notifications (Gmail SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASSWORD=your-app-password
APPROVAL_EMAIL=your@email.com

# Site URL (for approval links in emails)
SITE_URL=https://api.risingcompass.net
