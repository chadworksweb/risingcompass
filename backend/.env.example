# Admin
RC_ADMIN_KEY=change-me

# API key for public endpoints (RC frontend, Lyric Transformer, Lyrical Charger)
RC_API_KEY=change-me

# Database
DATABASE_URL=sqlite:///./data/rising_compass.db

# CORS (JSON array)
CORS_ORIGINS=["https://risingcompass.net","https://api.risingcompass.net"]

# Anthropic API (required for agent calibration)
ANTHROPIC_API_KEY=sk-ant-...

# Genius API (lyrics fetching)
GENIUS_ACCESS_TOKEN=...

# Email notifications (Resend API — https://resend.com)
RESEND_API_KEY=re_...
EMAIL_FROM=Rising Compass <compass@risingcompass.net>
APPROVAL_EMAIL=your@email.com
MISREAD_NOTIFY_EMAIL=your@email.com

# Site URL (for approval links in emails)
SITE_URL=https://api.risingcompass.net

# DO Spaces backup destination (daily dump of Turso → gzipped .db upload)
DO_SPACES_KEY=
DO_SPACES_SECRET=
DO_SPACES_BUCKET=crystopa-forge-backup1
DO_SPACES_REGION=nyc3
DO_SPACES_PREFIX=le-projects-01/risingcompass
BACKUP_RETENTION_DAYS=30
